{
  "name": "gunk-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "UI-agnostic capability-centric decomposition engine for gunk.",
  "bin": {
    "gunk-engine": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "eval": "bun run src/index.ts eval",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "build": "bun run scripts/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.4",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.25.0",
    "zod": "^3.24.1"
  }
}
